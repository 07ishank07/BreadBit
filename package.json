{
  "name": "breadbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --config apps/desktop/vite.config.ts",
    "build": "npm run assets && vite build --config apps/desktop/vite.config.ts",
    "test": "vitest run && tsx --test packages/circuit-renderer/tests/*.test.ts",
    "typecheck": "tsc -p packages/project-core/tsconfig.json --noEmit && tsc -p packages/runtime-contracts/tsconfig.json --noEmit && node scripts/typecheck-app.mjs",
    "doctor": "node scripts/doctor.mjs",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "backend:check": "node services/local-backend/dev.mjs --check",
    "backend:dev": "node services/local-backend/dev.mjs --start",
    "typecheck:app": "node scripts/typecheck-app.mjs"
  },
  "dependencies": {
    "@google/genai": "^0.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-table": "^8.20.5",
    "@tauri-apps/api": "^2.10.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@wasm-fmt/clang-format": "22.1.8",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "@wokwi/elements": "1.9.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "avr8js": "0.21.0",
    "axios": "^1.13.6",
    "esptool-js": "0.6.1",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "littlefs": "^0.1.0",
    "lucide-react": "^0.460.0",
    "monaco-editor": "0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "rp2040js": "1.3.2",
    "three": "^0.186.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
